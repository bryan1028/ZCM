# Firebase Admin (server only). Leave unset to run on local demo data.
# The service-account JSON, either raw on one line or base64-encoded (base64 -w0 key.json).
FIREBASE_SERVICE_ACCOUNT=
# Basic-auth password for /admin (username: admin)
ADMIN_PASSWORD=
# Public site URL, used for canonical links and sitemap
NEXT_PUBLIC_SITE_URL=https://zist.it.com
