# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL (used for magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: web push notifications (in-app notifications work without these) ──
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server-only! Never prefix with NEXT_PUBLIC. Used only to read push subscriptions when sending.
SUPABASE_SERVICE_ROLE_KEY=
# Protects /api/push/flush if you call it from a scheduler
CRON_SECRET=

# Shown on the Terms / Privacy pages as the contact address (optional)
NEXT_PUBLIC_SUPPORT_EMAIL=
